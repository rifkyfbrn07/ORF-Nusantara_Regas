generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
}

enum ScheduleStatus {
  WORK
  OFF
}

enum AttendanceStatus {
  HADIR
  TERLAMBAT
  BELUM_ABSEN
  ABSENT
  IZIN
  CUTI
  SAKIT
  OFF
}

enum LeaveType {
  LEAVE
  PERMISSION
  SICK
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HandoverStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

enum ChecklistStatus {
  PENDING
  COMPLETED
}

enum ChecklistItemStatus {
  YES
  NO
  NA
}

enum NotificationType {
  SHIFT_REMINDER
  ATTENDANCE_ALERT
  LEAVE_STATUS
  SHIFT_EXCHANGE
  SYSTEM
  HSSE
  ANNOUNCEMENT
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementTargetType {
  ALL
  SHIFT
  OPERATOR
}

enum ProgramCategory {
  PENGADAAN
  RAPAT_KOORDINASI
  OPERASIONAL_RUTIN
  AUDIT
}

enum ProgramStatus {
  PLAN
  REALISASI
  ON_PROGRESS
  BELUM_TEREALISASI
}

/** Status riwayat update program — default TERKIRIM (approval workflow belum ada). */
enum ProgramUpdateStatus {
  DRAFT
  TERKIRIM
  DIVERIFIKASI
  DITOLAK
}

enum ImportDocumentType {
  PROGRAM_KERJA
  JADWAL_KERJA
}

enum ImportStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  users                  User[]
  operationalReports     OperationalReport[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model Location {
  id             String          @id @default(cuid())
  name           String          @unique
  code           String          @unique
  address        String?
  schedules      Schedule[]
  hsseChecklists HSSEChecklist[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Shift {
  id             String          @id @default(cuid())
  name           String          @unique
  code           String          @unique
  startTime      String
  endTime        String
  durationHours  Int             @default(8)
  description    String?
  requiredCount  Int             @default(6)
  isActive       Boolean         @default(true)
  schedules      Schedule[]
  handovers      Handover[]
  hsseChecklists HSSEChecklist[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model User {
  id                     String              @id @default(cuid())
  employeeId             String              @unique
  username               String              @unique
  name                   String
  email                  String?             @unique
  passwordHash           String
  role                   Role                @default(OPERATOR)
  position               String
  phone                  String?
  avatarUrl              String?
  /** Tim roster ORF (A | B | C) — dipakai untuk pemetaan Reviewer/Team Lead approval cuti. */
  team                   String?
  /** Tanggal masuk kerja (YYYY-MM-DD) untuk auto-fill Formulir Permohonan Cuti. */
  joinedDate             String?
  isActive               Boolean             @default(true)
  departmentId           String?
  department             Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  schedules              Schedule[]
  attendances            Attendance[]
  leaveRequests          LeaveRequest[]      @relation("OperatorLeaves")
  reviewedLeaves         LeaveRequest[]      @relation("ManagerReviewedLeaves")
  requestedExchanges     ShiftExchange[]     @relation("RequesterExchanges")
  targetExchanges        ShiftExchange[]     @relation("TargetExchanges")
  reviewedExchanges      ShiftExchange[]     @relation("ManagerReviewedExchanges")
  outgoingHandovers      Handover[]          @relation("OutgoingHandovers")
  incomingHandovers      Handover[]          @relation("IncomingHandovers")
  hsseChecklists         HSSEChecklist[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  picPrograms            ProgramKerja[]      @relation("ProgramKerjaPic")
  uploadedProgramKerjaEvidence ProgramKerja[] @relation("ProgramKerjaEvidenceUploaders")
  programProgressLogs    ProgramKerjaProgressLog[] @relation("ProgramKerjaProgressActors")
  programUpdates         ProgramUpdate[]     @relation("ProgramUpdateSubmitters")
programScheduleHistories ProgramKerjaScheduleHistory[] @relation("ProgramScheduleHistoryEditors")
programRealizationLogs   ProgramKerjaRealizationLog[] @relation("ProgramRealizationLogEditors")
  createdAnnouncements   Announcement[]      @relation("CreatedAnnouncements")
  uploadedReports        OperationalReport[] @relation("UploadedReports")
  dataImports            DataImport[]        @relation("DataImportActors")
  infoOrfReports         InfoOrfReport[]     @relation("InfoOrfRecordedBy")
  nextCargoUpdates       NextCargo[]         @relation("NextCargoUpdaters")

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([email])
  @@index([employeeId])
  @@index([role])
}

model Schedule {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId            String
  shift              Shift           @relation(fields: [shiftId], references: [id])
  locationId         String
  location           Location        @relation(fields: [locationId], references: [id])
  date               String
  status             ScheduleStatus  @default(WORK)
  notes              String?
  attendances        Attendance[]
  requesterExchanges ShiftExchange[] @relation("RequesterSchedule")
  targetExchanges    ShiftExchange[] @relation("TargetSchedule")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date, shiftId])
  @@index([status])
}

model Attendance {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleId       String?
  schedule         Schedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  date             String
  checkIn          DateTime?
  checkOut         DateTime?
  status           AttendanceStatus @default(BELUM_ABSEN)
  lateMinutes      Int              @default(0)
  checkInLocation  String?
  checkOutLocation String?
  notes            String?
  verifiedBy       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date, status])
  @@index([status])
  @@index([scheduleId])
}

model LeaveRequest {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation("OperatorLeaves", fields: [userId], references: [id], onDelete: Cascade)
  type             LeaveType     @default(LEAVE)
  startDate        String
  endDate          String
  reason           String
  attachmentUrl    String?
  attachmentName   String?
  attachmentMime   String?
  attachmentSize   Int?
  driveFileId      String?
  driveWebViewLink String?
  storageProvider  String?
  storagePath      String?
  uploadedAt       DateTime?
  /** Cleanup evidence na REJECTED: null | CLEANED | FAILED | PENDING_RETRY */
  evidenceCleanupStatus String?
  evidenceCleanupAt   DateTime?
  status           RequestStatus @default(PENDING)
  /**
   * Workflow approval berurutan 3 tahap: REVIEWER -> TEAM_LEAD -> MANAGER.
   * approvalStage = tahap yang SEDANG berjalan (menunggu). Nilai: REVIEWER | TEAM_LEAD | MANAGER.
   */
  approvalStage    String        @default("REVIEWER")
  // Tahap 1 — Reviewer (tim sendiri)
  reviewerId       String?
  reviewerName     String?
  reviewerApprovedAt DateTime?
  reviewerNote     String?
  // Tahap 2 — Team Lead
  teamLeadId       String?
  teamLeadName     String?
  teamLeadApprovedAt DateTime?
  teamLeadNote     String?
  // Tahap 3 — Manager (keputusan akhir)
  managerId        String?
  managerName      String?
  managerApprovedAt DateTime?
  managerNote      String?
  /** Waktu evidence difinalisasi (setelah approval Manager). */
  finalizedAt      DateTime?
  /** Kolom kompatibilitas lama — diisi kembali saat keputusan final (Manager). */
  reviewedById     String?
  reviewedBy       User?         @relation("ManagerReviewedLeaves", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, status])
  @@index([startDate, endDate])
  @@index([status])
  @@index([approvalStage])
}

/**
 * Konfigurasi pemetaan Reviewer & Team Lead per tim roster (A/B/C).
 * Dipakai oleh workflow approval cuti — dikelola oleh Admin.
 * reviewerId/teamLeadId/managerId menyimpan User.id (tanpa FK agar ringan).
 */
model TeamConfig {
  id         String   @id @default(cuid())
  code       String   @unique // 'A' | 'B' | 'C'
  name       String
  reviewerId String?
  teamLeadId String?
  managerId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ShiftExchange {
  id                  String        @id @default(cuid())
  requesterId         String
  requester           User          @relation("RequesterExchanges", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterScheduleId String
  requesterSchedule   Schedule      @relation("RequesterSchedule", fields: [requesterScheduleId], references: [id], onDelete: Cascade)
  targetUserId        String
  targetUser          User          @relation("TargetExchanges", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetScheduleId    String
  targetSchedule      Schedule      @relation("TargetSchedule", fields: [targetScheduleId], references: [id], onDelete: Cascade)
  targetDate          String
  reason              String
  attachmentUrl       String?
  attachmentName      String?
  attachmentMime      String?
  attachmentSize      Int?
  driveFileId         String?
  driveWebViewLink    String?
  storageProvider     String?
  storagePath         String?
  uploadedAt          DateTime?
  targetAcceptedAt    DateTime?
  /** Operator B confirmation: PENDING | ACCEPTED | REJECTED — gescheiden van manager approval. */
  confirmationStatus  String          @default("PENDING")
  /** Manager/Admin final approval: PENDING | APPROVED | REJECTED. */
  approvalStatus      String          @default("PENDING")
  /** Cleanup evidence na REJECTED: null | CLEANED | FAILED | PENDING_RETRY */
  evidenceCleanupStatus String?
  evidenceCleanupAt   DateTime?
  status              RequestStatus @default(PENDING)
  reviewedById        String?
  reviewedBy          User?         @relation("ManagerReviewedExchanges", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  reviewerNote        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([requesterId, status])
  @@index([targetUserId, status])
  @@index([status])
}

model Handover {
  id                 String         @id @default(cuid())
  date               String
  shiftId             String
  shift               Shift          @relation(fields: [shiftId], references: [id])
  outgoingOperatorId String
  outgoingOperator   User           @relation("OutgoingHandovers", fields: [outgoingOperatorId], references: [id])
  incomingOperatorId String
  incomingOperator   User           @relation("IncomingHandovers", fields: [incomingOperatorId], references: [id])
  operationalNotes   String
  equipmentStatus    String
  issues             String?
  pendingTasks       String?
  safetyNotes        String?
  status             HandoverStatus @default(DRAFT)
  acknowledgedAt     DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([date, shiftId])
  @@index([outgoingOperatorId])
  @@index([incomingOperatorId])
  @@index([status])
}

model HSSEChecklist {
  id         String              @id @default(cuid())
  date       String
  shiftId    String
  shift      Shift               @relation(fields: [shiftId], references: [id])
  operatorId String
  operator   User                @relation(fields: [operatorId], references: [id])
  locationId String
  location   Location            @relation(fields: [locationId], references: [id])
  status     ChecklistStatus     @default(PENDING)
  notes      String?
  items      HSSEChecklistItem[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([date, shiftId])
  @@index([operatorId])
  @@index([status])
}

model HSSEChecklistItem {
  id          String              @id @default(cuid())
  checklistId String
  checklist   HSSEChecklist       @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  itemKey     String
  label       String
  status      ChecklistItemStatus @default(YES)
  note        String?

  @@index([checklistId])
}

model Announcement {
  id          String                 @id @default(cuid())
  title       String
  message     String
  priority    AnnouncementPriority   @default(NORMAL)
  targetType  AnnouncementTargetType @default(ALL)
  targetId    String?
  startAt     DateTime               @default(now())
  endAt       DateTime?
  createdById String
  createdBy   User                   @relation("CreatedAnnouncements", fields: [createdById], references: [id])
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([priority])
  @@index([targetType, targetId])
  @@index([startAt, endAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ProgramKerja {
  id              String                  @id @default(cuid())
  year            Int
  category        ProgramCategory
  sequence        Int
  name            String
  plan            String?
  realization     String?
  planTarget      Int                     @default(100)
  progress        Int                     @default(0)
  status          ProgramStatus           @default(PLAN)
  notes           String?
  deadline        DateTime?
  picId           String?
  pic             User?                   @relation("ProgramKerjaPic", fields: [picId], references: [id], onDelete: SetNull)
  picProgress     Int                     @default(0)
  evidenceUrl     String?
  evidenceName    String?
  evidenceMime    String?
  evidenceSize    Int?
  driveFileId     String?
  driveWebViewLink String?
  evidenceUploadedAt  DateTime?
  evidenceUploadedById String?
  evidenceUploadedBy  User?                  @relation("ProgramKerjaEvidenceUploaders", fields: [evidenceUploadedById], references: [id], onDelete: SetNull)
  storageProvider String?
  storagePath     String?
  tasks           ProgramKerjaTask[]
  months          ProgramKerjaMonth[]
  progressLogs    ProgramKerjaProgressLog[]
  updates         ProgramUpdate[]
scheduleHistories ProgramKerjaScheduleHistory[]
realizationLogs   ProgramKerjaRealizationLog[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([year, category, name])
  @@index([year])
  @@index([category])
  @@index([status])
  @@index([picId])
  @@index([evidenceUploadedById])
}

model ProgramKerjaTask {
  id        String      @id @default(cuid())
  programId String
  program   ProgramKerja @relation(fields: [programId], references: [id], onDelete: Cascade)
  label     String
  isDone    Boolean     @default(false)
  doneAt    DateTime?
  doneById  String?
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([programId])
}

model ProgramKerjaProgressLog {
  id                String       @id @default(cuid())
  programId         String
  program           ProgramKerja @relation(fields: [programId], references: [id], onDelete: Cascade)
  oldProgress       Int          @default(0)
  newProgress       Int          @default(0)
  note              String?
  evidenceUrl       String?
  evidenceName      String?
  evidenceMime      String?
  evidenceSize      Int?
  driveFileId       String?
  driveWebViewLink  String?
  storageProvider   String?
  storagePath       String?
  userId            String
  user              User         @relation("ProgramKerjaProgressActors", fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())

  @@index([programId])
  @@index([userId])
}

/**
 * Riwayat Update Program — setiap pengiriman update/upload realisasi adalah
 * record terpisah (append-only). Tidak pernah menimpa/replace update lama dan
 * TIDAK pernah mengubah Plan/Realisasi program.
 */
model ProgramUpdate {
  id               String              @id @default(cuid())
  programId        String
  program          ProgramKerja        @relation(fields: [programId], references: [id], onDelete: Cascade)
  /** Pengirim update — null sebagai fallback aman bila user terhapus. */
  userId           String?
  user             User?               @relation("ProgramUpdateSubmitters", fields: [userId], references: [id], onDelete: SetNull)
  /** Periode yang dilaporkan, mis. "September 2026". */
  period           String?
  notes            String?
  fileName         String?
  mimeType         String?
  fileSize         Int?
  /** URL legacy / fallback (mis. tautan Drive lama). Bukan URL publik untuk Blob. */
  fileUrl          String?
  driveFileId      String?
  driveWebViewLink String?
  storageProvider  String?
  storagePath      String?
  status           ProgramUpdateStatus @default(TERKIRIM)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([programId])
  @@index([userId])
  @@index([status])
}

model ProgramKerjaMonth {
  id          String      @id @default(cuid())
  programId   String
  program     ProgramKerja @relation(fields: [programId], references: [id], onDelete: Cascade)
  month       Int
  week        Int
  /** Nilai Plan (P) pada periode bulan + minggu. NULL = tidak ada data (sel kosong), bukan 0. */
  target      Int?
  /** Nilai Realisasi (R) pada periode bulan + minggu. NULL = tidak ada data (sel kosong), bukan 0. */
  realization Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([programId, month, week])
  @@index([programId, month])
  @@index([month])
}

/**
 * Riwayat / histori Import Data (Excel / PDF).
 * Data dokumen hanya dianggap sebagai input — seluruh perubahan ditulis
 * dalam satu database transaction dan dicatat di sini.
 */

/**
 * Riwayat perubahan jadwal Program Kerja.
 * Setiap kali jadwal (bulan pelaksanaan) program diubah, catat:
 * jadwal sebelumnya, jadwal baru, waktu perubahan, dan pengguna yang mengubah.
 * Tidak pernah menimpa/replace record lama — append-only.
 */
model ProgramKerjaScheduleHistory {
id String @id @default(cuid())
programId String
program ProgramKerja @relation(fields: [programId], references: [id], onDelete: Cascade)
previousYear Int
previousMonth Int?
newYear Int
newMonth Int?
changedById String
changedBy User @relation("ProgramScheduleHistoryEditors", fields: [changedById], references: [id])
changedAt DateTime @default(now())
reason String?

@@index([programId])
@@index([changedById])
@@index([changedAt])
}

/**
 * Riwayat perubahan realisasi per periode (bulan) Program Kerja.
 * Catat: Program, periode yang diperbarui, nilai sebelumnya, nilai baru,
 * waktu pembaruan, dan pengguna yang melakukan perubahan.
 * Digunakan untuk membedakan "Tambah realisasi" vs "Edit/koreksi realisasi".
 */
model ProgramKerjaRealizationLog {
id String @id @default(cuid())
programId String
program ProgramKerja @relation(fields: [programId], references: [id], onDelete: Cascade)
year Int
month Int
oldRealization Int?
newRealization Int
changedById String
changedBy User @relation("ProgramRealizationLogEditors", fields: [changedById], references: [id])
changedAt DateTime @default(now())
note String?

@@index([programId])
@@index([programId, year, month])
@@index([changedById])
@@index([changedAt])
}

model DataImport {
  id                String             @id @default(cuid())
  fileName          String
  fileHash          String
  fileSize          Int
  documentType      ImportDocumentType @default(PROGRAM_KERJA)
  status            ImportStatus       @default(PENDING)
  /** Daftar sheet yang dibaca (JSON array string). */
  sheetNames        Json?
  year              Int?
  totalRecords      Int                @default(0)
  planRecords       Int                @default(0)
  realizationRecords Int               @default(0)
  notesRecords      Int                @default(0)
  createdCount      Int                @default(0)
  updatedCount      Int                @default(0)
  unchangedCount    Int                @default(0)
  conflictCount      Int                @default(0)
  rejectedCount      Int                @default(0)
  /** Snapshot ringkas hasil parse + preview perubahan (JSON). */
  summary           Json?
  errorSummary      String?
  importedById      String?
  importedBy        User?              @relation("DataImportActors", fields: [importedById], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([documentType])
  @@index([status])
  @@index([importedById])
  @@index([createdAt])
}

model OperationalReport {
  id               String      @id @default(cuid())
  title            String
  reportType       String      // e.g. 'HARIAN', 'DISTRIBUSI_GAS', 'HSSE', 'MAINTENANCE', 'BULANAN'
  periodDate       String      // YYYY-MM-DD
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description      String?
  attachmentUrl    String?
  attachmentName   String?
  attachmentMime   String?
  attachmentSize   Int?
  driveFileId      String?
  driveWebViewLink String?
  storageProvider  String?
  storagePath      String?
  uploadedById     String
  uploadedBy       User        @relation("UploadedReports", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([reportType])
  @@index([periodDate])
  @@index([uploadedById])
}

// ============================================================================
// INFO ORF — DATA OPERASIONAL PER JAM (WIB)
// ----------------------------------------------------------------------------
// Setiap TANGGAL dapat memiliki BANYAK laporan (satu per jam pencatatan).
//   - Unik per (reportDate, reportHour) → mencegah duplikasi periode pencatatan.
//   - reportTime = timestamp WIB (date + hour) untuk sortir kronologis.
//   - Nilai metrik/line disimpan APA ADANYA (Decimal + satuan) — TIDAK
//     dijumlahkan lintas jam. Tampilan memakai nilai laporan pada jam terpilih.
//   - NextCargo adalah entitas TERPISAH yang diperbarui lewat mekanismenya
//     sendiri (bukan otomatis berubah setiap jam).
// ============================================================================

enum InfoOrfSection {
  UPSTREAM
  TOTAL
  FSRU
}

enum NextCargoStatus {
  SCHEDULED
  DISCHARGING
  COMPLETED
  CANCELLED
}

enum InfoOrfReportSource {
  MANUAL
  AUTOMATIC
}

model InfoOrfReport {
  id           String           @id @default(cuid())
  reportDate   String // YYYY-MM-DD (WIB)
  reportHour   String // 'HH' 00–23 (WIB) — periode pencatatan
  reportTime   DateTime // timestamp WIB (date + hour) untuk sortir/display
  source       InfoOrfReportSource @default(MANUAL)
  wasEdited    Boolean            @default(false)
  note         String?
  recordedById String
  recordedBy   User             @relation("InfoOrfRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  nextCargoId  String?
  nextCargo    NextCargo?       @relation("InfoOrfNextCargo", fields: [nextCargoId], references: [id], onDelete: SetNull)
  metrics      InfoOrfMetric[]
  lines        InfoOrfLine[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([reportDate, reportHour])
  @@index([reportDate])
  @@index([reportTime])
}

model InfoOrfMetric {
  id        String          @id @default(cuid())
  reportId  String
  report    InfoOrfReport   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  section   InfoOrfSection
  key       String // identifier field (e.g. 'TOTAL_FLOW')
  label     String // label tampilan (e.g. 'Total Penyaluran Gas')
  value     Decimal         @db.Decimal(18, 4)
  unit      String // satuan (e.g. 'MMSCFD', 'psig', 'm³', '%', '°C')
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([reportId])
}

model InfoOrfLine {
  id         String        @id @default(cuid())
  reportId   String
  report     InfoOrfReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  lineCode   String // kode line (e.g. 'LINE-01')
  lineName   String // nama line / pelanggan (e.g. 'PLN Nusantara Power')
  flowRate   Decimal?      @db.Decimal(18, 4) // MMSCFD
  volume     Decimal?      @db.Decimal(18, 4) // m³
  energy     Decimal?      @db.Decimal(18, 4) // MMBTU
  temperature Decimal?     @db.Decimal(18, 4) // Deg F
  flowUnit   String        @default("MMSCFD")
  volumeUnit String        @default("m³")
  energyUnit String        @default("MMBTU")
  temperatureUnit String   @default("°F")
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([reportId])
}

model NextCargo {
  id              String           @id @default(cuid())
  eta             DateTime // WIB
  cargoCode       String
  vesselName      String?
  volumeLng       Decimal?         @db.Decimal(18, 2) // m³
  note            String?
  status          NextCargoStatus  @default(SCHEDULED)
  lastUpdatedById String?
  lastUpdatedBy   User?            @relation("NextCargoUpdaters", fields: [lastUpdatedById], references: [id], onDelete: SetNull)
  infoOrfReports  InfoOrfReport[]  @relation("InfoOrfNextCargo")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
  @@index([eta])
}
