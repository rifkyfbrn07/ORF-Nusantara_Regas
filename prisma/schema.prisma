generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
}

enum ScheduleStatus {
  WORK
  OFF
}

enum AttendanceStatus {
  HADIR
  TERLAMBAT
  BELUM_ABSEN
  ABSENT
  IZIN
  CUTI
  SAKIT
  OFF
}

enum LeaveType {
  LEAVE
  PERMISSION
  SICK
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HandoverStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

enum ChecklistStatus {
  PENDING
  COMPLETED
}

enum ChecklistItemStatus {
  YES
  NO
  NA
}

enum NotificationType {
  SHIFT_REMINDER
  ATTENDANCE_ALERT
  LEAVE_STATUS
  SHIFT_EXCHANGE
  SYSTEM
  HSSE
  ANNOUNCEMENT
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementTargetType {
  ALL
  SHIFT
  OPERATOR
}

enum ProgramCategory {
  PENGADAAN
  RAPAT_KOORDINASI
  OPERASIONAL_RUTIN
  AUDIT
}

enum ProgramStatus {
  PLAN
  REALISASI
  ON_PROGRESS
  BELUM_TEREALISASI
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  users                  User[]
  operationalReports     OperationalReport[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model Location {
  id             String          @id @default(cuid())
  name           String          @unique
  code           String          @unique
  address        String?
  schedules      Schedule[]
  hsseChecklists HSSEChecklist[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Shift {
  id             String          @id @default(cuid())
  name           String          @unique
  code           String          @unique
  startTime      String
  endTime        String
  durationHours  Int             @default(8)
  description    String?
  requiredCount  Int             @default(6)
  isActive       Boolean         @default(true)
  schedules      Schedule[]
  handovers      Handover[]
  hsseChecklists HSSEChecklist[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model User {
  id                     String              @id @default(cuid())
  employeeId             String              @unique
  username               String              @unique
  name                   String
  email                  String?             @unique
  passwordHash           String
  role                   Role                @default(OPERATOR)
  position               String
  phone                  String?
  avatarUrl              String?
  isActive               Boolean             @default(true)
  departmentId           String?
  department             Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  schedules              Schedule[]
  attendances            Attendance[]
  leaveRequests          LeaveRequest[]      @relation("OperatorLeaves")
  reviewedLeaves         LeaveRequest[]      @relation("ManagerReviewedLeaves")
  requestedExchanges     ShiftExchange[]     @relation("RequesterExchanges")
  targetExchanges        ShiftExchange[]     @relation("TargetExchanges")
  reviewedExchanges      ShiftExchange[]     @relation("ManagerReviewedExchanges")
  outgoingHandovers      Handover[]          @relation("OutgoingHandovers")
  incomingHandovers      Handover[]          @relation("IncomingHandovers")
  hsseChecklists         HSSEChecklist[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  picPrograms            ProgramKerja[]      @relation("ProgramKerjaPic")
  programProgressLogs    ProgramKerjaProgressLog[] @relation("ProgramKerjaProgressActors")
  createdAnnouncements   Announcement[]      @relation("CreatedAnnouncements")
  uploadedReports        OperationalReport[] @relation("UploadedReports")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([email])
  @@index([employeeId])
  @@index([role])
}

model Schedule {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shiftId            String
  shift              Shift           @relation(fields: [shiftId], references: [id])
  locationId         String
  location           Location        @relation(fields: [locationId], references: [id])
  date               String
  status             ScheduleStatus  @default(WORK)
  notes              String?
  attendances        Attendance[]
  requesterExchanges ShiftExchange[] @relation("RequesterSchedule")
  targetExchanges    ShiftExchange[] @relation("TargetSchedule")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date, shiftId])
  @@index([status])
}

model Attendance {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleId       String?
  schedule         Schedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  date             String
  checkIn          DateTime?
  checkOut         DateTime?
  status           AttendanceStatus @default(BELUM_ABSEN)
  lateMinutes      Int              @default(0)
  checkInLocation  String?
  checkOutLocation String?
  notes            String?
  verifiedBy       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@index([date, status])
  @@index([status])
  @@index([scheduleId])
}

model LeaveRequest {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation("OperatorLeaves", fields: [userId], references: [id], onDelete: Cascade)
  type             LeaveType     @default(LEAVE)
  startDate        String
  endDate          String
  reason           String
  attachmentUrl    String?
  attachmentName   String?
  attachmentMime   String?
  attachmentSize   Int?
  driveFileId      String?
  driveWebViewLink String?
  uploadedAt       DateTime?
  status           RequestStatus @default(PENDING)
  reviewedById     String?
  reviewedBy       User?         @relation("ManagerReviewedLeaves", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  reviewerNote     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, status])
  @@index([startDate, endDate])
  @@index([status])
}

model ShiftExchange {
  id                  String        @id @default(cuid())
  requesterId         String
  requester           User          @relation("RequesterExchanges", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterScheduleId String
  requesterSchedule   Schedule      @relation("RequesterSchedule", fields: [requesterScheduleId], references: [id], onDelete: Cascade)
  targetUserId        String
  targetUser          User          @relation("TargetExchanges", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetScheduleId    String
  targetSchedule      Schedule      @relation("TargetSchedule", fields: [targetScheduleId], references: [id], onDelete: Cascade)
  targetDate          String
  reason              String
  attachmentUrl       String?
  attachmentName      String?
  attachmentMime      String?
  attachmentSize      Int?
  driveFileId         String?
  driveWebViewLink    String?
  uploadedAt          DateTime?
  targetAcceptedAt    DateTime?
  status              RequestStatus @default(PENDING)
  reviewedById        String?
  reviewedBy          User?         @relation("ManagerReviewedExchanges", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  reviewerNote        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([requesterId, status])
  @@index([targetUserId, status])
  @@index([status])
}

model Handover {
  id                 String         @id @default(cuid())
  date               String
  shiftId             String
  shift               Shift          @relation(fields: [shiftId], references: [id])
  outgoingOperatorId String
  outgoingOperator   User           @relation("OutgoingHandovers", fields: [outgoingOperatorId], references: [id])
  incomingOperatorId String
  incomingOperator   User           @relation("IncomingHandovers", fields: [incomingOperatorId], references: [id])
  operationalNotes   String
  equipmentStatus    String
  issues             String?
  pendingTasks       String?
  safetyNotes        String?
  status             HandoverStatus @default(DRAFT)
  acknowledgedAt     DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([date, shiftId])
  @@index([outgoingOperatorId])
  @@index([incomingOperatorId])
  @@index([status])
}

model HSSEChecklist {
  id         String              @id @default(cuid())
  date       String
  shiftId    String
  shift      Shift               @relation(fields: [shiftId], references: [id])
  operatorId String
  operator   User                @relation(fields: [operatorId], references: [id])
  locationId String
  location   Location            @relation(fields: [locationId], references: [id])
  status     ChecklistStatus     @default(PENDING)
  notes      String?
  items      HSSEChecklistItem[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([date, shiftId])
  @@index([operatorId])
  @@index([status])
}

model HSSEChecklistItem {
  id          String              @id @default(cuid())
  checklistId String
  checklist   HSSEChecklist       @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  itemKey     String
  label       String
  status      ChecklistItemStatus @default(YES)
  note        String?

  @@index([checklistId])
}

model Announcement {
  id          String                 @id @default(cuid())
  title       String
  message     String
  priority    AnnouncementPriority   @default(NORMAL)
  targetType  AnnouncementTargetType @default(ALL)
  targetId    String?
  startAt     DateTime               @default(now())
  endAt       DateTime?
  createdById String
  createdBy   User                   @relation("CreatedAnnouncements", fields: [createdById], references: [id])
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([priority])
  @@index([targetType, targetId])
  @@index([startAt, endAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ProgramKerja {
  id              String                  @id @default(cuid())
  year            Int
  category        ProgramCategory
  sequence        Int
  name            String
  plan            String?
  realization     String?
  planTarget      Int                     @default(100)
  progress        Int                     @default(0)
  status          ProgramStatus           @default(PLAN)
  notes           String?
  deadline        DateTime?
  picId           String?
  pic             User?                   @relation("ProgramKerjaPic", fields: [picId], references: [id], onDelete: SetNull)
  picProgress     Int                     @default(0)
  evidenceUrl     String?
  evidenceName    String?
  evidenceMime    String?
  evidenceSize    Int?
  driveFileId     String?
  driveWebViewLink String?
  tasks           ProgramKerjaTask[]
  months          ProgramKerjaMonth[]
  progressLogs    ProgramKerjaProgressLog[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([year, category, name])
  @@index([year])
  @@index([category])
  @@index([status])
  @@index([picId])
}

model ProgramKerjaTask {
  id        String      @id @default(cuid())
  programId String
  program   ProgramKerja @relation(fields: [programId], references: [id], onDelete: Cascade)
  label     String
  isDone    Boolean     @default(false)
  doneAt    DateTime?
  doneById  String?
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([programId])
}

model ProgramKerjaProgressLog {
  id                String       @id @default(cuid())
  programId         String
  program           ProgramKerja @relation(fields: [programId], references: [id], onDelete: Cascade)
  oldProgress       Int          @default(0)
  newProgress       Int          @default(0)
  note              String?
  evidenceUrl       String?
  evidenceName      String?
  evidenceMime      String?
  evidenceSize      Int?
  driveFileId       String?
  driveWebViewLink  String?
  userId            String
  user              User         @relation("ProgramKerjaProgressActors", fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())

  @@index([programId])
  @@index([userId])
}

model ProgramKerjaMonth {
  id          String      @id @default(cuid())
  programId   String
  program     ProgramKerja @relation(fields: [programId], references: [id], onDelete: Cascade)
  month       Int
  week        Int
  target      Int         @default(100)
  realization Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([programId, month, week])
  @@index([programId, month])
  @@index([month])
}

model OperationalReport {
  id               String      @id @default(cuid())
  title            String
  reportType       String      // e.g. 'HARIAN', 'DISTRIBUSI_GAS', 'HSSE', 'MAINTENANCE', 'BULANAN'
  periodDate       String      // YYYY-MM-DD
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  description      String?
  attachmentUrl    String?
  attachmentName   String?
  attachmentMime   String?
  attachmentSize   Int?
  driveFileId      String?
  driveWebViewLink String?
  uploadedById     String
  uploadedBy       User        @relation("UploadedReports", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([reportType])
  @@index([periodDate])
  @@index([uploadedById])
}
